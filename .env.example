# Leave MA_LLM_API_KEY empty to run fully offline (rule-based planner and writer).
# Any OpenAI-compatible endpoint works. Example: Gemini through its OpenAI-compatible API.
MA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MA_LLM_API_KEY=
MA_LLM_MODEL=gemini-2.5-flash

MA_RATE_LIMIT_PER_MINUTE=30
MA_ALLOWED_ORIGINS=["*"]
MA_LOG_LEVEL=INFO
