# Copy to .env. Never commit .env: it holds keys.
# With no LLM settings at all, the assistant runs fully offline (rule-based planner and writer).

# --- Option A: one OpenAI-compatible provider ---
MA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MA_LLM_API_KEY=
MA_LLM_MODEL=gemini-2.5-flash

# --- Option B: a provider group with automatic failover ---
# Tried in order. When one is out of quota, rate-limited or down, the next one answers,
# and the first is retried after a cooldown. Keys are read from the env vars named here.
# Providers whose key variable is empty are skipped.
# MA_LLM_PROVIDERS=[{"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","model":"gemini-2.5-flash","api_key_env":"GEMINI_API_KEY"},{"name":"groq","base_url":"https://api.groq.com/openai/v1","model":"llama-3.3-70b-versatile","api_key_env":"GROQ_API_KEY"},{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","model":"meta-llama/llama-3.3-70b-instruct:free","api_key_env":"OPENROUTER_API_KEY"},{"name":"local","base_url":"http://localhost:11434/v1","model":"qwen2.5:7b"}]
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Database: SQLite by default; set this to use PostgreSQL through the read-only role ---
# MA_DATABASE_URL=postgresql://market_ro:change-me@localhost:5432/market
# MA_RO_PASSWORD=change-me

MA_RATE_LIMIT_PER_MINUTE=30
MA_ALLOWED_ORIGINS=["*"]
MA_LOG_LEVEL=INFO
